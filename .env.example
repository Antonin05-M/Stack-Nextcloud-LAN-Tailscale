# =============================================================================
# Modèle de fichier .env — copiez-le en .env puis remplissez les valeurs.
#
#   cp .env.example .env
#   openssl rand -hex 32      # à exécuter 3 fois : DB, root, secret JWT
#   chmod 600 .env
#
# ⚠️ Le vrai .env ne doit JAMAIS être commité (voir .gitignore).
# =============================================================================

# Base de données Nextcloud
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# Mot de passe root MariaDB
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Secret JWT partagé entre ONLYOFFICE DocumentServer et le connecteur
# Nextcloud (même valeur des deux côtés, obligatoire depuis ONLYOFFICE 7.2)
ONLYOFFICE_JWT_SECRET=CHANGE_ME_ONLYOFFICE_SECRET

# /etc/systemd/system/nextcloud-restic-backup.service
# Sauvegarde quotidienne Nextcloud (Restic + dump MariaDB)
[Unit]
Description=Nextcloud Restic Backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backup-nextcloud-restic.sh

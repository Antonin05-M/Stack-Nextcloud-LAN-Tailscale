# /etc/systemd/system/nextcloud-cert-renew.timer
# Déclenchement : chaque jour vers 04:30 + délai aléatoire (<= 30 min)
# pour ne pas saturer les endpoints Let's Encrypt à heure fixe.
[Unit]
Description=Daily Nextcloud TLS Certificate Renewal

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
